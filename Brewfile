# -------------------------------------------------------
# Core CLI tools
# -------------------------------------------------------
brew "git"
brew "gh"           # GitHub CLI
brew "curl"
brew "wget"
brew "jq"           # JSON processor
brew "ripgrep"      # Fast grep (rg)
brew "fzf"          # Fuzzy finder
brew "tree"         # Directory tree view
brew "chezmoi"      # Dotfile manager

# -------------------------------------------------------
# Shell enhancements
# -------------------------------------------------------
brew "zsh-autosuggestions"      # Fish-like autosuggestions
brew "zsh-syntax-highlighting"  # Fish-like syntax highlighting

# -------------------------------------------------------
# Node / JS
# -------------------------------------------------------
brew "node"         # Node.js + npm
brew "fnm"          # Fast Node Manager (replaces nvm)

# -------------------------------------------------------
# Java / JVM — managed by SDKMAN (see bootstrap.sh), not Homebrew.
# SDKMAN's installer needs Bash 4+; macOS ships 3.2, so install a modern bash.
# -------------------------------------------------------
brew "bash"

